{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "eshkra",
	"compatibility_date": "2026-10-01",
	// Static site: Workers serves the Astro build output, no Worker script.
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
	},
	// Creates the DNS record and certificate for the zone on deploy.
	"routes": [{ "pattern": "eshkra.dev", "custom_domain": true }],
}
