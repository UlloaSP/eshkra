---
import type { Product } from '../data/products';

interface Props {
	id: Product['id'];
	class?: string;
}

// The brand lockup for every visible product name: "ML" wide and bold, the rest thin.
const { id, class: className } = Astro.props;
---

<span class:list={['wordmark', className]}
	><span class="ml">ML</span><span class="rest">{id.slice(2)}</span></span
>

<style>
	.wordmark {
		white-space: nowrap;
	}

	.ml {
		font-weight: 800;
		font-stretch: 125%;
		letter-spacing: -0.01em;
	}

	.rest {
		font-weight: 300;
		font-stretch: 100%;
	}
</style>
